"""MCP Server for Spark AgentCore Gateway"""

import json
import os
import asyncio
from typing import Any, Dict
from mcp.server import Server
from mcp.server.stdio import stdio_server
from mcp.types import Tool, TextContent
import httpx

# Gateway configuration
GATEWAY_URL = os.getenv("SPARK_GATEWAY_URL", "http://localhost:8000")
JWT_TOKEN = os.getenv("SPARK_JWT_TOKEN", "")

# Create MCP server
server = Server("spark-agentcore-gateway")

@server.list_tools()
async def list_tools() -> list[Tool]:
    """List available MCP tools"""
    return [
        Tool(
            name="invoke_spark_agent",
            description="""
            Invoke the Spark Supervisor Agent to generate and execute Spark code.
            
            This tool wraps the entire Spark workflow:
            1. Generate PySpark code from natural language prompt
            2. Validate the generated code
            3. Execute on Lambda or EMR Serverless
            4. Return results with execution logs
            
            Supports multiple data sources:
            - S3 CSV files
            - AWS Glue Catalog tables
            - PostgreSQL databases
            
            Parameters:
            - prompt: Natural language description of the Spark job
            - session_id: Optional session identifier for tracking
            - s3_input_path: Optional S3 path to input CSV file
            - s3_output_path: Optional S3 path for output results
            - selected_tables: Optional list of Glue tables (format: ["db.table"])
            - selected_postgres_tables: Optional list of PostgreSQL table metadata
            - execution_platform: "lambda" or "emr" (default: "lambda")
            - skip_generation: Set to true to execute pre-validated code
            - spark_code: Pre-validated Spark code (only if skip_generation=true)
            
            Returns:
            - success: Boolean indicating success/failure
            - session_id: Session identifier
            - result: Agent execution result with:
              - spark_code: Generated/executed Spark code
              - execution_result: "success" or "failed"
              - execution_message: Execution summary
              - execution_output: Array of log lines
              - actual_results: Data results from S3
              - s3_output_path: S3 path where results are stored
            """,
            inputSchema={
                "type": "object",
                "properties": {
                    "prompt": {
                        "type": "string",
                        "description": "Natural language description of the Spark job"
                    },
                    "session_id": {
                        "type": "string",
                        "description": "Optional session identifier"
                    },
                    "s3_input_path": {
                        "type": "string",
                        "description": "Optional S3 path to input CSV file"
                    },
                    "s3_output_path": {
                        "type": "string",
                        "description": "Optional S3 path for output results"
                    },
                    "selected_tables": {
                        "type": "array",
                        "items": {"type": "string"},
                        "description": "Optional list of Glue tables (format: ['db.table'])"
                    },
                    "selected_postgres_tables": {
                        "type": "array",
                        "items": {"type": "object"},
                        "description": "Optional list of PostgreSQL table metadata"
                    },
                    "execution_platform": {
                        "type": "string",
                        "enum": ["lambda", "emr", "auto"],
                        "description": "Execution platform (default: lambda)"
                    },
                    "skip_generation": {
                        "type": "boolean",
                        "description": "Skip code generation and execute pre-validated code"
                    },
                    "spark_code": {
                        "type": "string",
                        "description": "Pre-validated Spark code (only if skip_generation=true)"
                    }
                },
                "required": ["prompt"]
            }
        ),
        Tool(
            name="list_glue_databases",
            description="List all AWS Glue databases available for querying",
            inputSchema={
                "type": "object",
                "properties": {}
            }
        ),
        Tool(
            name="list_glue_tables",
            description="List all tables in a specific Glue database with schema information",
            inputSchema={
                "type": "object",
                "properties": {
                    "database": {
                        "type": "string",
                        "description": "Glue database name"
                    }
                },
                "required": ["database"]
            }
        ),
        Tool(
            name="list_postgres_connections",
            description="List all configured PostgreSQL connections",
            inputSchema={
                "type": "object",
                "properties": {}
            }
        ),
        Tool(
            name="list_postgres_databases",
            description="List all databases in a PostgreSQL connection",
            inputSchema={
                "type": "object",
                "properties": {
                    "connection_name": {
                        "type": "string",
                        "description": "PostgreSQL connection name"
                    }
                },
                "required": ["connection_name"]
            }
        ),
        Tool(
            name="list_postgres_schemas",
            description="List all schemas in a PostgreSQL database",
            inputSchema={
                "type": "object",
                "properties": {
                    "connection_name": {
                        "type": "string",
                        "description": "PostgreSQL connection name"
                    },
                    "database": {
                        "type": "string",
                        "description": "Database name"
                    }
                },
                "required": ["connection_name", "database"]
            }
        ),
        Tool(
            name="list_postgres_tables",
            description="List all tables in a PostgreSQL schema with column information",
            inputSchema={
                "type": "object",
                "properties": {
                    "connection_name": {
                        "type": "string",
                        "description": "PostgreSQL connection name"
                    },
                    "database": {
                        "type": "string",
                        "description": "Database name"
                    },
                    "schema": {
                        "type": "string",
                        "description": "Schema name"
                    }
                },
                "required": ["connection_name", "database", "schema"]
            }
        )
    ]

async def make_gateway_request(method: str, endpoint: str, data: Dict[str, Any] = None) -> Dict[str, Any]:
    """Make authenticated request to the gateway"""
    if not JWT_TOKEN:
        raise ValueError("JWT_TOKEN environment variable not set")
    
    headers = {
        "Authorization": f"Bearer {JWT_TOKEN}",
        "Content-Type": "application/json"
    }
    
    url = f"{GATEWAY_URL}{endpoint}"
    
    async with httpx.AsyncClient(timeout=1260.0) as client:  # 21 minute timeout
        if method == "GET":
            response = await client.get(url, headers=headers)
        elif method == "POST":
            response = await client.post(url, headers=headers, json=data)
        else:
            raise ValueError(f"Unsupported method: {method}")
        
        response.raise_for_status()
        return response.json()

@server.call_tool()
async def call_tool(name: str, arguments: Any) -> list[TextContent]:
    """Handle MCP tool calls"""
    try:
        if name == "invoke_spark_agent":
            # Main agent invocation
            result = await make_gateway_request("POST", "/invoke", arguments)
            return [TextContent(
                type="text",
                text=json.dumps(result, indent=2)
            )]
        
        elif name == "list_glue_databases":
            result = await make_gateway_request("GET", "/glue/databases")
            return [TextContent(
                type="text",
                text=json.dumps(result, indent=2)
            )]
        
        elif name == "list_glue_tables":
            database = arguments.get("database")
            result = await make_gateway_request("GET", f"/glue/tables/{database}")
            return [TextContent(
                type="text",
                text=json.dumps(result, indent=2)
            )]
        
        elif name == "list_postgres_connections":
            result = await make_gateway_request("GET", "/postgres/connections")
            return [TextContent(
                type="text",
                text=json.dumps(result, indent=2)
            )]
        
        elif name == "list_postgres_databases":
            connection_name = arguments.get("connection_name")
            result = await make_gateway_request("GET", f"/postgres/{connection_name}/databases")
            return [TextContent(
                type="text",
                text=json.dumps(result, indent=2)
            )]
        
        elif name == "list_postgres_schemas":
            connection_name = arguments.get("connection_name")
            database = arguments.get("database")
            result = await make_gateway_request("GET", f"/postgres/{connection_name}/schemas/{database}")
            return [TextContent(
                type="text",
                text=json.dumps(result, indent=2)
            )]
        
        elif name == "list_postgres_tables":
            connection_name = arguments.get("connection_name")
            database = arguments.get("database")
            schema = arguments.get("schema")
            result = await make_gateway_request("GET", f"/postgres/{connection_name}/tables/{database}/{schema}")
            return [TextContent(
                type="text",
                text=json.dumps(result, indent=2)
            )]
        
        else:
            raise ValueError(f"Unknown tool: {name}")
    
    except Exception as e:
        error_msg = f"Error calling tool {name}: {str(e)}"
        return [TextContent(
            type="text",
            text=json.dumps({"error": error_msg}, indent=2)
        )]

async def main():
    """Run the MCP server"""
    async with stdio_server() as (read_stream, write_stream):
        await server.run(
            read_stream,
            write_stream,
            server.create_initialization_options()
        )

if __name__ == "__main__":
    asyncio.run(main())
