"""AgentCore Gateway for Spark Supervisor Agent with Cognito JWT Authentication"""

import json
import os
import logging
from typing import Optional, Dict, Any
import boto3
from jose import jwt, JWTError
from fastapi import FastAPI, HTTPException, Depends, Header
from fastapi.middleware.cors import CORSMiddleware
from pydantic import BaseModel
import time

try:
    from .config_snowflake import load_config, save_config
    from .postgres_metadata import get_postgres_metadata_fetcher
except ImportError:
    from config_snowflake import load_config, save_config
    from postgres_metadata import get_postgres_metadata_fetcher

logger = logging.getLogger(__name__)
logging.basicConfig(level=logging.INFO)

app = FastAPI(title="Spark AgentCore Gateway with JWT Auth")

app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

# Cognito configuration (loaded from environment)
COGNITO_REGION = os.getenv("COGNITO_REGION", "us-east-1")
COGNITO_USER_POOL_ID = os.getenv("COGNITO_USER_POOL_ID", "")
COGNITO_APP_CLIENT_ID = os.getenv("COGNITO_APP_CLIENT_ID", "")

# Cache for Cognito public keys
_cognito_keys = None
_keys_last_fetched = 0
KEYS_CACHE_TTL = 3600  # 1 hour

def get_cognito_public_keys():
    """Fetch and cache Cognito public keys for JWT verification"""
    global _cognito_keys, _keys_last_fetched
    
    current_time = time.time()
    if _cognito_keys and (current_time - _keys_last_fetched) < KEYS_CACHE_TTL:
        return _cognito_keys
    
    keys_url = f"https://cognito-idp.{COGNITO_REGION}.amazonaws.com/{COGNITO_USER_POOL_ID}/.well-known/jwks.json"
    
    try:
        import requests
        response = requests.get(keys_url, timeout=10)
        response.raise_for_status()
        _cognito_keys = response.json()
        _keys_last_fetched = current_time
        return _cognito_keys
    except Exception as e:
        logger.error(f"Failed to fetch Cognito public keys: {e}")
        raise HTTPException(status_code=500, detail="Failed to fetch authentication keys")

def verify_jwt_token(token: str) -> Dict[str, Any]:
    """Verify JWT token from Cognito"""
    if not COGNITO_USER_POOL_ID or not COGNITO_APP_CLIENT_ID:
        raise HTTPException(status_code=500, detail="Cognito not configured")
    
    try:
        # Get public keys
        keys = get_cognito_public_keys()
        
        # Get the kid from the token header
        headers = jwt.get_unverified_headers(token)
        kid = headers.get('kid')
        
        if not kid:
            raise HTTPException(status_code=401, detail="Invalid token: missing kid")
        
        # Find the correct key
        key = None
        for k in keys.get('keys', []):
            if k.get('kid') == kid:
                key = k
                break
        
        if not key:
            raise HTTPException(status_code=401, detail="Invalid token: key not found")
        
        # Verify the token
        payload = jwt.decode(
            token,
            key,
            algorithms=['RS256'],
            audience=COGNITO_APP_CLIENT_ID,
            issuer=f"https://cognito-idp.{COGNITO_REGION}.amazonaws.com/{COGNITO_USER_POOL_ID}"
        )
        
        return payload
    
    except JWTError as e:
        logger.error(f"JWT verification failed: {e}")
        raise HTTPException(status_code=401, detail=f"Invalid token: {str(e)}")
    except Exception as e:
        logger.error(f"Token verification error: {e}")
        raise HTTPException(status_code=401, detail="Token verification failed")

async def get_current_user(authorization: Optional[str] = Header(None)) -> Dict[str, Any]:
    """Dependency to extract and verify JWT token from Authorization header"""
    if not authorization:
        raise HTTPException(status_code=401, detail="Authorization header missing")
    
    # Extract token from "Bearer <token>"
    parts = authorization.split()
    if len(parts) != 2 or parts[0].lower() != "bearer":
        raise HTTPException(status_code=401, detail="Invalid authorization header format")
    
    token = parts[1]
    return verify_jwt_token(token)

# AgentCore client
def get_agentcore_client():
    """Get AgentCore client with extended timeout"""
    return boto3.client(
        'bedrock-agentcore',
        region_name='us-east-1',
        config=boto3.session.Config(
            read_timeout=1200,  # 20 minutes for EMR workloads
            connect_timeout=30,
            retries={'max_attempts': 3}
        )
    )

# Pydantic models
class SparkInvokeRequest(BaseModel):
    prompt: str
    session_id: Optional[str] = None
    s3_input_path: Optional[str] = None
    s3_output_path: Optional[str] = None
    selected_tables: Optional[list] = None
    selected_postgres_tables: Optional[list] = None
    execution_platform: str = "lambda"
    skip_generation: bool = False
    spark_code: Optional[str] = None

class HealthResponse(BaseModel):
    status: str
    gateway_version: str
    cognito_configured: bool
    spark_supervisor_arn: Optional[str]
    timestamp: float

@app.get("/health", response_model=HealthResponse)
async def health_check():
    """Health check endpoint (no auth required)"""
    config = load_config()
    spark_supervisor_arn = config.get("spark", {}).get("supervisor_arn")
    
    return HealthResponse(
        status="healthy",
        gateway_version="1.0.0",
        cognito_configured=bool(COGNITO_USER_POOL_ID and COGNITO_APP_CLIENT_ID),
        spark_supervisor_arn=spark_supervisor_arn,
        timestamp=time.time()
    )

@app.post("/invoke")
async def invoke_spark_agent(
    request: SparkInvokeRequest,
    user: Dict[str, Any] = Depends(get_current_user)
):
    """
    Invoke Spark Supervisor Agent with JWT authentication
    
    This is the main MCP tool endpoint that wraps the entire agent invocation.
    """
    try:
        logger.info(f"User {user.get('sub')} invoking Spark agent")
        logger.info(f"Prompt: {request.prompt[:100]}...")
        
        # Load configuration
        config = load_config()
        spark_supervisor_arn = config.get("spark", {}).get("supervisor_arn")
        
        if not spark_supervisor_arn:
            raise HTTPException(status_code=500, detail="Spark supervisor not configured")
        
        # Generate session ID if not provided
        import uuid
        session_id = request.session_id or f"spark-{uuid.uuid4().hex}"
        
        # Ensure session ID is at least 33 characters
        if len(session_id) < 33:
            session_id = f"spark-session-{uuid.uuid4().hex}"
        
        # Set output path
        s3_bucket = config.get("spark", {}).get("s3_bucket")
        s3_output_path = request.s3_output_path or f"s3://{s3_bucket}/output/{session_id}"
        
        # Determine execution platform
        execution_platform = request.execution_platform
        if request.selected_postgres_tables:
            execution_platform = 'emr'  # PostgreSQL requires EMR with VPC
        elif request.selected_tables:
            execution_platform = 'emr'  # Glue tables use EMR
        
        # Merge global and spark settings
        spark_config = config.get("spark", {}).copy()
        global_config = config.get("global", {})
        
        if "bedrock_model" in global_config:
            spark_config["model_id"] = global_config["bedrock_model"]
        if "code_gen_agent_arn" in global_config:
            spark_config["code_gen_agent_arn"] = global_config["code_gen_agent_arn"]
        if "bedrock_region" in global_config:
            spark_config["bedrock_region"] = global_config["bedrock_region"]
        
        # Set EMR application based on data source
        if request.selected_postgres_tables:
            spark_config["emr_application_id"] = spark_config.get("emr_postgres_application_id")
            spark_config["jdbc_driver_path"] = config.get("postgres", {}).get("jdbc_driver_path")
        elif request.selected_tables:
            spark_config["emr_application_id"] = config.get("spark", {}).get("emr_application_id")
            spark_config.pop("jdbc_driver_path", None)
        
        # Build payload for agent
        payload = {
            "prompt": request.prompt,
            "session_id": session_id,
            "s3_input_path": request.s3_input_path,
            "s3_output_path": s3_output_path,
            "selected_tables": request.selected_tables,
            "selected_postgres_tables": request.selected_postgres_tables,
            "execution_platform": execution_platform,
            "skip_generation": request.skip_generation,
            "spark_code": request.spark_code,
            "config": spark_config
        }
        
        # Add user context to payload
        payload["user_id"] = user.get("sub")
        payload["username"] = user.get("cognito:username", user.get("email", "unknown"))
        
        logger.info(f"Invoking agent with session_id: {session_id}")
        
        # Invoke agent
        client = get_agentcore_client()
        response = client.invoke_agent_runtime(
            agentRuntimeArn=spark_supervisor_arn,
            qualifier="DEFAULT",
            runtimeSessionId=session_id,
            payload=json.dumps(payload)
        )
        
        # Read response
        response_body = response["response"].read()
        if not response_body:
            raise HTTPException(status_code=500, detail="No response from agent")
        
        # Parse response
        result_text = response_body.decode('utf-8')
        agent_result = json.loads(result_text)
        
        # Handle multiple levels of JSON encoding
        while isinstance(agent_result, str):
            try:
                agent_result = json.loads(agent_result)
            except:
                break
        
        if not isinstance(agent_result, dict):
            raise HTTPException(status_code=500, detail="Invalid response format from agent")
        
        logger.info(f"Agent invocation successful for session {session_id}")
        
        return {
            "success": True,
            "session_id": session_id,
            "result": agent_result,
            "user_id": user.get("sub")
        }
    
    except HTTPException:
        raise
    except Exception as e:
        logger.error(f"Agent invocation failed: {e}")
        raise HTTPException(status_code=500, detail=str(e))

@app.get("/glue/databases")
async def list_glue_databases(user: Dict[str, Any] = Depends(get_current_user)):
    """List Glue databases (authenticated)"""
    try:
        glue_client = boto3.client('glue', region_name='us-east-1')
        response = glue_client.get_databases()
        databases = [db['Name'] for db in response.get('DatabaseList', [])]
        return {"success": True, "databases": databases}
    except Exception as e:
        logger.error(f"Failed to list databases: {e}")
        raise HTTPException(status_code=500, detail=str(e))

@app.get("/glue/tables/{database}")
async def list_glue_tables(database: str, user: Dict[str, Any] = Depends(get_current_user)):
    """List tables in a Glue database (authenticated)"""
    try:
        glue_client = boto3.client('glue', region_name='us-east-1')
        response = glue_client.get_tables(DatabaseName=database)
        tables = []
        for table in response.get('TableList', []):
            tables.append({
                "name": table['Name'],
                "location": table.get('StorageDescriptor', {}).get('Location', ''),
                "columns": [
                    {"name": col['Name'], "type": col['Type']}
                    for col in table.get('StorageDescriptor', {}).get('Columns', [])[:5]
                ]
            })
        return {"success": True, "tables": tables}
    except Exception as e:
        logger.error(f"Failed to list tables: {e}")
        raise HTTPException(status_code=500, detail=str(e))

@app.get("/postgres/connections")
async def list_postgres_connections(user: Dict[str, Any] = Depends(get_current_user)):
    """List PostgreSQL connections (authenticated)"""
    try:
        config = load_config()
        connections = config.get('postgres', {}).get('connections', [])
        return {
            "success": True,
            "connections": [
                {
                    "name": c['name'],
                    "description": c.get('description', ''),
                    "enabled": c.get('enabled', True)
                }
                for c in connections if c.get('enabled', True)
            ]
        }
    except Exception as e:
        logger.error(f"Failed to list connections: {e}")
        raise HTTPException(status_code=500, detail=str(e))

@app.get("/postgres/{connection_name}/databases")
async def list_postgres_databases(
    connection_name: str,
    user: Dict[str, Any] = Depends(get_current_user)
):
    """List databases in PostgreSQL connection (authenticated)"""
    try:
        config = load_config()
        connections = config.get('postgres', {}).get('connections', [])
        conn = next((c for c in connections if c['name'] == connection_name), None)
        
        if not conn:
            raise HTTPException(status_code=404, detail="Connection not found")
        
        fetcher = get_postgres_metadata_fetcher()
        databases = fetcher.list_databases(conn['secret_arn'])
        
        return {"success": True, "databases": databases}
    except HTTPException:
        raise
    except Exception as e:
        logger.error(f"Failed to list databases: {e}")
        raise HTTPException(status_code=500, detail=str(e))

@app.get("/postgres/{connection_name}/schemas/{database}")
async def list_postgres_schemas(
    connection_name: str,
    database: str,
    user: Dict[str, Any] = Depends(get_current_user)
):
    """List schemas in PostgreSQL database (authenticated)"""
    try:
        config = load_config()
        connections = config.get('postgres', {}).get('connections', [])
        conn = next((c for c in connections if c['name'] == connection_name), None)
        
        if not conn:
            raise HTTPException(status_code=404, detail="Connection not found")
        
        fetcher = get_postgres_metadata_fetcher()
        schemas = fetcher.list_schemas(conn['secret_arn'], database)
        
        return {"success": True, "schemas": schemas}
    except HTTPException:
        raise
    except Exception as e:
        logger.error(f"Failed to list schemas: {e}")
        raise HTTPException(status_code=500, detail=str(e))

@app.get("/postgres/{connection_name}/tables/{database}/{schema}")
async def list_postgres_tables(
    connection_name: str,
    database: str,
    schema: str,
    user: Dict[str, Any] = Depends(get_current_user)
):
    """List tables in PostgreSQL schema (authenticated)"""
    try:
        config = load_config()
        connections = config.get('postgres', {}).get('connections', [])
        conn = next((c for c in connections if c['name'] == connection_name), None)
        
        if not conn:
            raise HTTPException(status_code=404, detail="Connection not found")
        
        fetcher = get_postgres_metadata_fetcher()
        tables = fetcher.list_tables(conn['secret_arn'], database, schema)
        
        return {"success": True, "tables": tables}
    except HTTPException:
        raise
    except Exception as e:
        logger.error(f"Failed to list tables: {e}")
        raise HTTPException(status_code=500, detail=str(e))

@app.get("/")
async def root():
    """Root endpoint with gateway information (no auth required)"""
    config = load_config()
    return {
        "message": "Spark AgentCore Gateway with Cognito JWT Authentication",
        "version": "1.0.0",
        "authentication": "JWT (Cognito)",
        "endpoints": {
            "/health": "GET - Health check (no auth)",
            "/invoke": "POST - Invoke Spark agent (authenticated)",
            "/glue/databases": "GET - List Glue databases (authenticated)",
            "/glue/tables/{database}": "GET - List Glue tables (authenticated)",
            "/postgres/connections": "GET - List PostgreSQL connections (authenticated)",
            "/postgres/{connection}/databases": "GET - List PostgreSQL databases (authenticated)",
            "/postgres/{connection}/schemas/{database}": "GET - List PostgreSQL schemas (authenticated)",
            "/postgres/{connection}/tables/{database}/{schema}": "GET - List PostgreSQL tables (authenticated)"
        },
        "cognito_configured": bool(COGNITO_USER_POOL_ID and COGNITO_APP_CLIENT_ID),
        "spark_supervisor_arn": config.get("spark", {}).get("supervisor_arn", "not configured")
    }

# Lambda handler using Mangum
from mangum import Mangum
handler = Mangum(app, lifespan="off")

if __name__ == "__main__":
    import uvicorn
    uvicorn.run(app, host="0.0.0.0", port=8000)
