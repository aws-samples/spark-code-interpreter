{
  "mcpServers": {
    "spark-gateway": {
      "command": "python",
      "args": ["/absolute/path/to/backend/backend/mcp_server.py"],
      "env": {
        "SPARK_GATEWAY_URL": "https://your-alb-url.us-east-1.elb.amazonaws.com",
        "SPARK_JWT_TOKEN": "your-jwt-token-here"
      }
    }
  }
}
